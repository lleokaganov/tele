# Rust build artifacts
target/

# Node
node_modules/

# Gradle / Android build output
**/build/
.gradle/
*.apk
local.properties
android/android/app/src/main/assets/public/

# wasm-pack output (regenerated by wasm/RUN.sh)
pkg/

# Real server keys — NEVER commit these.
# server/src/server_keys.rs is generated from server_keys.rs.example with
# your own deployment keypair (see README "Generating server keys").
server_keys.rs

# Secrets / env
.env
*.env

# Generated by `npx cap copy` from web/ — never publish a second, stale copy of
# the client. A snapshot committed here once shipped a link-preview fetch that
# the live client had already lost.
android/**/assets/public/
android/**/assets/capacitor.config.json
android/**/assets/capacitor.plugins.json
.kotlin/
